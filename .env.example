# LLM API Keys & Provider Settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database Connector Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lyxai

# Voice & STT Engine Settings
STT_MODEL_SIZE=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_VOICE=ta-IN-PallaviNeural

# Optional System Binary Overrides
# FFMPEG_CMD=/usr/bin/ffmpeg
# FFPROBE_CMD=/usr/bin/ffprobe
